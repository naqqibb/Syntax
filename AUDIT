    portfolio = build_demo_portfolio()
    report = portfolio.build_report()

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        portfolio.print_report(report)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        # Downstream closed the pipe (e.g. `| head`); exit quietly.
        sys.stderr.close()
        sys.exit(0)
