def rate_risk(findings: Sequence[AuditFinding]) -> RiskRating:
    """Roll findings up into an FM residual risk rating.

    Any single critical finding carries the project to High; severity counts
    below that escalate on volume, since a scatter of medium findings is itself
    a control-environment signal.
    """
    counts = {severity: 0 for severity in Severity}
    for finding in findings:
        counts[finding.severity] += 1

    if counts[Severity.CRITICAL] >= 1:
        return RiskRating.HIGH
    if counts[Severity.HIGH] >= 3:
        return RiskRating.HIGH
    if counts[Severity.HIGH] >= 1 or counts[Severity.MEDIUM] >= 3:
        return RiskRating.SUBSTANTIAL
    if counts[Severity.MEDIUM] >= 1 or counts[Severity.LOW] >= 3:
        return RiskRating.MODERATE
    return RiskRating.LOW


class AuditPortfolio:
    """Holds projects, runs the interim audit, and reports."""

    def __init__(self, registry: Optional[DebarmentRegistry] = None) -> None:
        self.projects: List[Project] = []
        self.registry = registry or DebarmentRegistry()
        self.system = InterimAuditSystem(registry=self.registry)

    def add(self, project: Project) -> Project:
        self.projects.append(project)
        return project

    def findings_for(self, project: Project) -> List[AuditFinding]:
        return self.system.audit(project)

    def evasion_signals(self) -> List[Dict[str, object]]:
        """Fiduciary findings rendered as SANCTIONS-shaped evasion signals.

        Emitted as plain dictionaries so this module stays importable without
        SANCTIONS present; `to_sanctions_signals` builds the real objects.
        """
        signals: List[Dict[str, object]] = []
        for project in self.projects:
            for finding in self.findings_for(project):
                bridge = TYPOLOGY_BRIDGE.get(finding.code)
                typology = finding.typology_hint or (bridge[0] if bridge else None)
                if typology is None:
                    continue
                confidence = bridge[1] if bridge else 0.40
                signals.append({
                    "typology": typology,
                    "description": finding.detail,
                    "jurisdiction": project.country,
                    "confidence": confidence,
                    "sources": [
                        f"wb-audit:{project.project_id}:{ref}"
                        for ref in finding.references
                    ],
                })
        return signals

    def to_sanctions_signals(self) -> List[object]:
        """Build real SANCTIONS EvasionSignal objects from the audit.

        Raises if the SANCTIONS module is unavailable or has no matching
        typology, rather than silently dropping evidence.
        """
        sanctions = load_sanctions_module()
        built = []
        for payload in self.evasion_signals():
            typology = getattr(sanctions.EvasionTypology, str(payload["typology"]))
            built.append(sanctions.EvasionSignal(
                typology=typology,
                description=str(payload["description"]),
                jurisdiction=str(payload["jurisdiction"]),
                confidence=float(payload["confidence"]),
                sources=list(payload["sources"]),
            ))
        return built

    def build_report(self) -> Dict[str, object]:
        entries = []
        for project in self.projects:
            findings = self.findings_for(project)
            counts = {severity.value: 0 for severity in Severity}
            for finding in findings:
                counts[finding.severity.value] += 1
            entries.append({
                "project_id": project.project_id,
                "name": project.name,
                "country": project.country,
                "audit_opinion": project.audit_opinion.name,
                "risk_rating": rate_risk(findings).value,
                "findings_total": len(findings),
                "severity_counts": counts,
                "reports": [report.to_dict() for report in project.reports],
                "contracts": [contract.to_dict() for contract in project.contracts],
                "findings": [finding.to_dict() for finding in findings],
            })

        return {
            "status": "OPERATIONAL",
            "module": "SYNTAX AUDIT",
            "generated_at": _utcnow(),
            "projects_reviewed": len(entries),
            "high_risk_projects": sum(
                1 for entry in entries if entry["risk_rating"] == RiskRating.HIGH.value
            ),
            "findings_total": sum(int(entry["findings_total"]) for entry in entries),
            "projects": entries,
            "evasion_signals": self.evasion_signals(),
        }

    def print_report(self, report: Optional[Dict[str, object]] = None) -> None:
        if report is None:
            report = self.build_report()

        severity_colors = {
            "CRITICAL": Colors.RED,
            "HIGH": Colors.YELLOW,
            "MEDIUM": Colors.CYAN,
            "LOW": Colors.GREEN,
            "INFO": Colors.WHITE,
        }
        risk_colors = {
            "High": Colors.RED,
            "Substantial": Colors.YELLOW,
            "Moderate": Colors.CYAN,
            "Low": Colors.GREEN,
        }

        print("=" * 78)
        print(f"{Colors.BOLD}{Colors.CYAN}SYNTAX WORLD BANK INTERIM AUDIT{Colors.RESET}")
        print(f"Generated {report['generated_at']}")
        print("=" * 78)

        for entry in report["projects"]:
            color = risk_colors.get(str(entry["risk_rating"]), Colors.WHITE)
            print(f"\n{Colors.BOLD}{Colors.MAGENTA}> {entry['project_id']} "
                  f"{entry['name']} ({entry['country']}){Colors.RESET}")
            print("-" * 78)
            print(
                f"FM risk {color}{entry['risk_rating']}{Colors.RESET} | "
                f"opinion {entry['audit_opinion']} | "
                f"findings {entry['findings_total']}"
            )

            for report_entry in entry["reports"]:
                da = report_entry["designated_account"]
                print(
                    f"  IFR {report_entry['period']} submitted "
                    f"+{report_entry['submission_lag_days']}d | "
                    f"spend ${report_entry['total_expenditure_usd']:,.0f} | "
                    f"DA gap ${da['reconciliation_gap_usd']:,.2f}"
                )

            for finding in entry["findings"]:
                fcolor = severity_colors.get(str(finding["severity"]), Colors.WHITE)
                print(
                    f"  {fcolor}[{finding['severity']:>8}]{Colors.RESET} "
                    f"{finding['code']}"
                )
                print(f"             {finding['detail']}")

        print(f"\n{Colors.BOLD}{Colors.MAGENTA}> Evasion signals emitted{Colors.RESET}")
        print("-" * 78)
        for signal in report["evasion_signals"]:
            print(
                f"{Colors.GREEN}[{signal['confidence']:.2f}]{Colors.RESET} "
                f"{signal['typology']} ({signal['jurisdiction']}) "
                f"<- {', '.join(signal['sources'])}"
            )

        print("\n" + "=" * 78)
        print(
            f"Projects: {report['projects_reviewed']} | "
            f"High risk: {report['high_risk_projects']} | "
            f"Findings: {report['findings_total']} | "
            f"Signals: {len(report['evasion_signals'])}"
        )
        print("=" * 78)


def load_sanctions_module():
    """Load the sibling SANCTIONS module, which has no file extension."""
    if "syntax_sanctions" in sys.modules:
        return sys.modules["syntax_sanctions"]

    module_path = Path(__file__).resolve().parent / "SANCTIONS"
    loader = importlib.machinery.SourceFileLoader("syntax_sanctions", str(module_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    # Registered before execution so dataclasses can resolve the module.
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


