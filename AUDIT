@dataclass
class ExpenditureCategory:
    """One disbursement category from the Financing Agreement."""
    code: str
    name: str
    allocation_usd: float
    financing_percentage: float = 100.0
    eligible: bool = True

    def __post_init__(self) -> None:
        if self.allocation_usd < 0:
            raise ValueError("allocation_usd must not be negative")
        if not 0.0 < self.financing_percentage <= 100.0:
            raise ValueError("financing_percentage must be within 0-100")


@dataclass
class Contract:
    """A procurement contract charged to a category."""
    contract_id: str
    supplier: str
    category_code: str
    amount_usd: float
    signed_date: str
    method: ProcurementMethod = ProcurementMethod.RFB
    prior_reviewed: bool = False

    def __post_init__(self) -> None:
        if self.amount_usd < 0:
            raise ValueError("amount_usd must not be negative")
        self.signed_day

    @property
    def signed_day(self) -> date:
        return date.fromisoformat(self.signed_date)

    def to_dict(self) -> Dict[str, object]:
        return {
            "contract_id": self.contract_id,
            "supplier": self.supplier,
            "category_code": self.category_code,
            "amount_usd": self.amount_usd,
            "signed_date": self.signed_date,
            "method": self.method.name,
            "prior_reviewed": self.prior_reviewed,
        }


@dataclass
class DesignatedAccount:
    """Designated Account movement for the reporting period."""
    opening_balance_usd: float
    advances_usd: float
    expenditures_usd: float
    closing_balance_usd: float

    @property
    def expected_closing_usd(self) -> float:
        return self.opening_balance_usd + self.advances_usd - self.expenditures_usd

    @property
    def reconciliation_gap_usd(self) -> float:
        return round(self.closing_balance_usd - self.expected_closing_usd, 2)


@dataclass
class InterimFinancialReport:
    """One quarterly IFR with its category expenditures and forecast."""
    project_id: str
    period_start: str
    period_end: str
    submitted_date: str
    designated_account: DesignatedAccount
    expenditures_by_category: Dict[str, float] = field(default_factory=dict)
    forecast_by_category: Dict[str, float] = field(default_factory=dict)
    soe_total_usd: float = 0.0

    def __post_init__(self) -> None:
        self.period_end_day
        self.submitted_day
        if date.fromisoformat(self.period_start) > self.period_end_day:
            raise ValueError("period_start must not follow period_end")

    @property
    def period_end_day(self) -> date:
        return date.fromisoformat(self.period_end)

    @property
    def submitted_day(self) -> date:
        return date.fromisoformat(self.submitted_date)

    @property
    def submission_lag_days(self) -> int:
        return (self.submitted_day - self.period_end_day).days

    @property
    def total_expenditure_usd(self) -> float:
        return round(sum(self.expenditures_by_category.values()), 2)

    def to_dict(self) -> Dict[str, object]:
        return {
            "project_id": self.project_id,
            "period": f"{self.period_start} to {self.period_end}",
            "submitted_date": self.submitted_date,
            "submission_lag_days": self.submission_lag_days,
            "total_expenditure_usd": self.total_expenditure_usd,
            "soe_total_usd": self.soe_total_usd,
            "expenditures_by_category": dict(self.expenditures_by_category),
            "forecast_by_category": dict(self.forecast_by_category),
            "designated_account": {
                "opening_balance_usd": self.designated_account.opening_balance_usd,
                "advances_usd": self.designated_account.advances_usd,
                "expenditures_usd": self.designated_account.expenditures_usd,
                "closing_balance_usd": self.designated_account.closing_balance_usd,
                "expected_closing_usd": self.designated_account.expected_closing_usd,
                "reconciliation_gap_usd": self.designated_account.reconciliation_gap_usd,
            },
        }


@dataclass
class Project:
    """A Bank-financed operation under fiduciary review."""
    project_id: str
    name: str
    country: str
    categories: Dict[str, ExpenditureCategory] = field(default_factory=dict)
    contracts: List[Contract] = field(default_factory=list)
    reports: List[InterimFinancialReport] = field(default_factory=list)
    audit_opinion: OpinionType = OpinionType.UNMODIFIED
    cumulative_by_category: Dict[str, float] = field(default_factory=dict)

    def __post_init__(self) -> None:
        self.country = self.country.upper()

    def add_category(self, category: ExpenditureCategory) -> "Project":
        self.categories[category.code] = category
        return self

    def add_contract(self, contract: Contract) -> "Project":
        self.contracts.append(contract)
        return self

    def add_report(self, report: InterimFinancialReport) -> "Project":
        self.reports.append(report)
        return self


