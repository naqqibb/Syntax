# DEBARMENT REGISTRY
# ============================================================================

class DebarmentBasis(Enum):
    """Why a counterparty appears on the register."""
    FRAUDULENT_PRACTICE = "Fraudulent practice"
    CORRUPT_PRACTICE = "Corrupt practice"
    COLLUSIVE_PRACTICE = "Collusive practice"
    COERCIVE_PRACTICE = "Coercive practice"
    OBSTRUCTIVE_PRACTICE = "Obstructive practice"


@dataclass(frozen=True)
class DebarmentEntry:
    """A debarred or cross-debarred counterparty."""
    name: str
    basis: DebarmentBasis
    from_date: str
    to_date: Optional[str] = None
    cross_debarred: bool = False

    def active_on(self, when: date) -> bool:
        if when < date.fromisoformat(self.from_date):
            return False
        if self.to_date is None:
            return True
        return when <= date.fromisoformat(self.to_date)


class DebarmentRegistry:
    """Name-matched register of debarred counterparties.

    Matching is normalized but deliberately conservative: a hit is a prompt to
    verify against the published register, never a determination on its own.
    """

    def __init__(self, entries: Optional[Sequence[DebarmentEntry]] = None) -> None:
        self.entries: List[DebarmentEntry] = list(entries or [])

    @staticmethod
    def normalize(name: str) -> str:
        cleaned = "".join(ch.lower() if ch.isalnum() else " " for ch in name)
        suffixes = {"ltd", "llc", "inc", "plc", "sa", "fze", "gmbh", "bv", "co"}
        tokens = [tok for tok in cleaned.split() if tok and tok not in suffixes]
        return " ".join(tokens)

    def add(self, entry: DebarmentEntry) -> "DebarmentRegistry":
        self.entries.append(entry)
        return self

    def match(self, supplier: str, when: date) -> Optional[DebarmentEntry]:
        target = self.normalize(supplier)
        if not target:
            return None
        for entry in self.entries:
            if self.normalize(entry.name) == target and entry.active_on(when):
                return entry
        return None


