TYPOLOGY_BRIDGE: Dict[FindingCode, Tuple[str, float]] = {
    FindingCode.DEBARRED_COUNTERPARTY: ("FRONT_PROCUREMENT_NETWORK", 0.65),
    FindingCode.CONTRACT_SPLITTING: ("SHELL_LAYERING", 0.55),
    FindingCode.PRIOR_REVIEW_BYPASS: ("FRONT_PROCUREMENT_NETWORK", 0.45),
    FindingCode.INELIGIBLE_EXPENDITURE: ("TRADE_MISINVOICING", 0.40),
    FindingCode.UNDISCLOSED_CATEGORY: ("TRADE_MISINVOICING", 0.40),
}


# ============================================================================
# SPLIT DETECTION
# ============================================================================

T = TypeVar("T")


def widest_qualifying_run(
    items: Sequence[T],
    when: Callable[[T], date],
    amount: Callable[[T], float],
    threshold: float,
    window_days: int,
) -> List[T]:
    """Largest set of sub-threshold items inside one window that clears it.

    Returns the widest run rather than the first qualifying pair, so a
    four-way split is not understated as a two-way one. An empty list means
    no run of two or more items clears the threshold within the window.
    """
    under = sorted(
        (item for item in items if amount(item) < threshold), key=when
    )
    best: List[T] = []
    for start in range(len(under)):
        for end in range(start + 1, len(under)):
            if (when(under[end]) - when(under[start])).days > window_days:
                break
            window = list(under[start:end + 1])
            if sum(amount(item) for item in window) >= threshold:
                if len(window) > len(best):
                    best = window
    return best


# ============================================================================
# INTERIM AUDIT SYSTEM
# ============================================================================

class InterimAuditSystem:
    """Runs the fiduciary checks over a project's interim reporting."""

    def __init__(
        self,
        parameters: AuditParameters = AUDIT_PARAMETERS,
        registry: Optional[DebarmentRegistry] = None,
    ) -> None:
        self.parameters = parameters
        self.registry = registry or DebarmentRegistry()

    def audit(self, project: Project) -> List[AuditFinding]:
        findings: List[AuditFinding] = []
        for report in project.reports:
            findings.extend(self._check_submission(project, report))
            findings.extend(self._check_designated_account(project, report))
            findings.extend(self._check_categories(project, report))
            findings.extend(self._check_soe(project, report))
            findings.extend(self._check_forecast(project, report))
        findings.extend(self._check_cumulative(project))
        findings.extend(self._check_procurement(project))
        findings.extend(self._check_opinion(project))
        findings.sort(key=lambda f: (SEVERITY_ORDER[f.severity], f.code.name))
        return findings

    def _check_submission(
        self, project: Project, report: InterimFinancialReport
    ) -> List[AuditFinding]:
        lag = report.submission_lag_days
        window = self.parameters.ifr_submission_days
        if lag <= window:
            return []
        overdue = lag - window
        return [AuditFinding(
            code=FindingCode.LATE_IFR_SUBMISSION,
            severity=Severity.HIGH if overdue > 30 else Severity.MEDIUM,
            detail=(
                f"IFR for {report.period_start} to {report.period_end} submitted "
                f"{lag} days after period end, {overdue} days past the "
                f"{window}-day covenant."
            ),
            project_id=project.project_id,
            references=[report.period_end],
        )]

    def _check_designated_account(
        self, project: Project, report: InterimFinancialReport
    ) -> List[AuditFinding]:
        gap = report.designated_account.reconciliation_gap_usd
        if abs(gap) <= self.parameters.da_reconciliation_tolerance_usd:
            return []
        direction = "unsupported" if gap > 0 else "unaccounted"
        return [AuditFinding(
            code=FindingCode.DA_UNRECONCILED,
            severity=Severity.CRITICAL,
            detail=(
                f"Designated Account closing balance differs from the expected "
                f"balance by ${gap:,.2f} ({direction})."
            ),
            project_id=project.project_id,
            references=[report.period_end],
            amount_usd=abs(gap),
        )]

    def _check_categories(
        self, project: Project, report: InterimFinancialReport
    ) -> List[AuditFinding]:
        findings: List[AuditFinding] = []
        for code, spent in sorted(report.expenditures_by_category.items()):
            category = project.categories.get(code)
            if category is None:
                findings.append(AuditFinding(
                    code=FindingCode.UNDISCLOSED_CATEGORY,
                    severity=Severity.HIGH,
                    detail=(
                        f"${spent:,.0f} charged to category '{code}', which is "
                        "not in the Financing Agreement."
                    ),
                    project_id=project.project_id,
                    references=[report.period_end, code],
                    amount_usd=spent,
                    typology_hint="TRADE_MISINVOICING",
                ))
                continue

            if not category.eligible:
                findings.append(AuditFinding(
                    code=FindingCode.INELIGIBLE_EXPENDITURE,
                    severity=Severity.CRITICAL,
                    detail=(
                        f"${spent:,.0f} charged to ineligible category "
                        f"{code} ({category.name}); refund may be required."
                    ),
                    project_id=project.project_id,
                    references=[report.period_end, code],
                    amount_usd=spent,
                    typology_hint="TRADE_MISINVOICING",
                ))
        return findings

    def _check_cumulative(self, project: Project) -> List[AuditFinding]:
        """Category allocation and financing-percentage checks.

        Cumulative totals carry prior-period spend, so they are checked once
        per project rather than once per report.
        """
        findings: List[AuditFinding] = []
        totals: Dict[str, float] = dict(project.cumulative_by_category)
        for report in project.reports:
            for code, spent in report.expenditures_by_category.items():
                totals[code] = totals.get(code, 0.0) + spent

        for code, total in sorted(totals.items()):
            category = project.categories.get(code)
            if category is None:
                continue
            # Ineligible spend is reported by _check_categories; re-reporting it
            # here as an allocation overrun would double-count the same dollars.

            if category.eligible and total > category.allocation_usd:
                overrun = total - category.allocation_usd
                findings.append(AuditFinding(
                    code=FindingCode.CATEGORY_OVERRUN,
                    severity=Severity.HIGH,
                    detail=(
                        f"Category {code} ({category.name}) cumulative "
                        f"${total:,.0f} exceeds the ${category.allocation_usd:,.0f} "
                        f"allocation by ${overrun:,.0f}."
                    ),
                    project_id=project.project_id,
                    references=[code],
                    amount_usd=overrun,
                ))

            ceiling = category.allocation_usd * category.financing_percentage / 100.0
            if category.financing_percentage < 100.0 and total > ceiling:
                findings.append(AuditFinding(
                    code=FindingCode.FINANCING_PERCENTAGE_BREACH,
                    severity=Severity.MEDIUM,
                    detail=(
                        f"Category {code} financed at "
                        f"{category.financing_percentage:.0f}% caps Bank funding at "
                        f"${ceiling:,.0f}; ${total:,.0f} claimed."
                    ),
                    project_id=project.project_id,
                    references=[code],
                    amount_usd=total - ceiling,
                ))
        return findings

    def _check_soe(
        self, project: Project, report: InterimFinancialReport
    ) -> List[AuditFinding]:
        total = report.total_expenditure_usd
        if total <= 0 or report.soe_total_usd <= 0:
            return []
        ratio = report.soe_total_usd / total
        if ratio <= self.parameters.soe_ceiling_ratio:
            return []
        return [AuditFinding(
            code=FindingCode.SOE_CEILING_EXCEEDED,
            severity=Severity.MEDIUM,
            detail=(
                f"SOE-supported spend is {ratio:.1%} of period expenditure, above "
                f"the {self.parameters.soe_ceiling_ratio:.0%} ceiling; full "
                "documentation required."
            ),
            project_id=project.project_id,
            references=[report.period_end],
            amount_usd=report.soe_total_usd,
        )]

    def _check_forecast(
        self, project: Project, report: InterimFinancialReport
    ) -> List[AuditFinding]:
        findings: List[AuditFinding] = []
        tolerance = self.parameters.forecast_variance_tolerance
        for code, forecast in sorted(report.forecast_by_category.items()):
            if forecast <= 0:
                continue
            actual = report.expenditures_by_category.get(code, 0.0)
            variance = (actual - forecast) / forecast
            if abs(variance) <= tolerance:
                continue
            findings.append(AuditFinding(
                code=FindingCode.FORECAST_VARIANCE_BREACH,
                severity=Severity.LOW,
                detail=(
                    f"Category {code} actual ${actual:,.0f} diverges "
                    f"{variance:+.1%} from the ${forecast:,.0f} forecast, beyond "
                    f"the {tolerance:.0%} tolerance."
                ),
                project_id=project.project_id,
                references=[report.period_end, code],
            ))
        return findings

    def _check_procurement(self, project: Project) -> List[AuditFinding]:
        findings: List[AuditFinding] = []
        threshold = self.parameters.prior_review_threshold_usd

        for contract in sorted(project.contracts, key=lambda c: c.contract_id):
            entry = self.registry.match(contract.supplier, contract.signed_day)
            if entry is not None:
                scope = "cross-debarred" if entry.cross_debarred else "debarred"
                findings.append(AuditFinding(
                    code=FindingCode.DEBARRED_COUNTERPARTY,
                    severity=Severity.CRITICAL,
                    detail=(
                        f"Contract {contract.contract_id} (${contract.amount_usd:,.0f}) "
                        f"awarded to '{contract.supplier}', {scope} for "
                        f"{entry.basis.value.lower()} as of {contract.signed_date}. "
                        "Verify against the published register."
                    ),
                    project_id=project.project_id,
                    references=[contract.contract_id],
                    amount_usd=contract.amount_usd,
                    typology_hint="FRONT_PROCUREMENT_NETWORK",
                ))

            if contract.amount_usd >= threshold and not contract.prior_reviewed:
                findings.append(AuditFinding(
                    code=FindingCode.PRIOR_REVIEW_BYPASS,
                    severity=Severity.HIGH,
                    detail=(
                        f"Contract {contract.contract_id} at ${contract.amount_usd:,.0f} "
                        f"is at or above the ${threshold:,.0f} prior-review threshold "
                        "but carries no prior review."
                    ),
                    project_id=project.project_id,
                    references=[contract.contract_id],
                    amount_usd=contract.amount_usd,
                    typology_hint="FRONT_PROCUREMENT_NETWORK",
                ))
            elif (
                contract.method in LIMITED_COMPETITION_METHODS
                and contract.amount_usd >= threshold * self.parameters.split_band
                and not contract.prior_reviewed
            ):
                findings.append(AuditFinding(
                    code=FindingCode.PRIOR_REVIEW_BYPASS,
                    severity=Severity.MEDIUM,
                    detail=(
                        f"Contract {contract.contract_id} at ${contract.amount_usd:,.0f} "
                        f"uses {contract.method.value.lower()} just below the "
                        f"${threshold:,.0f} threshold without prior review."
                    ),
                    project_id=project.project_id,
                    references=[contract.contract_id],
                    amount_usd=contract.amount_usd,
                    typology_hint="FRONT_PROCUREMENT_NETWORK",
                ))

        findings.extend(self._check_splitting(project))
        return findings

    def _check_splitting(self, project: Project) -> List[AuditFinding]:
        """Sub-threshold awards to one supplier in one category that aggregate.

        Grouped by supplier and category, since splitting to stay under prior
        review only works within a single procurement line.
        """
        findings: List[AuditFinding] = []
        threshold = self.parameters.prior_review_threshold_usd
        groups: Dict[Tuple[str, str], List[Contract]] = {}
        for contract in project.contracts:
            key = (contract.supplier, contract.category_code)
            groups.setdefault(key, []).append(contract)

        for (supplier, category_code), group in sorted(groups.items()):
            run = widest_qualifying_run(
                group,
                when=lambda c: c.signed_day,
                amount=lambda c: c.amount_usd,
                threshold=threshold,
                window_days=self.parameters.split_window_days,
            )
            if not run:
                continue
            total = sum(contract.amount_usd for contract in run)
            span = (run[-1].signed_day - run[0].signed_day).days
            findings.append(AuditFinding(
                code=FindingCode.CONTRACT_SPLITTING,
                severity=Severity.CRITICAL,
                detail=(
                    f"{len(run)} sub-threshold awards to '{supplier}' under "
                    f"category {category_code} totalling ${total:,.0f} across "
                    f"{span} days against a ${threshold:,.0f} prior-review "
                    "threshold."
                ),
                project_id=project.project_id,
                references=[contract.contract_id for contract in run],
                amount_usd=total,
                typology_hint="SHELL_LAYERING",
            ))
        return findings

    def _check_opinion(self, project: Project) -> List[AuditFinding]:
        if project.audit_opinion is OpinionType.UNMODIFIED:
            return []
        severity = (
            Severity.CRITICAL
            if project.audit_opinion in {OpinionType.ADVERSE, OpinionType.DISCLAIMER}
            else Severity.HIGH
        )
        return [AuditFinding(
            code=FindingCode.MODIFIED_AUDIT_OPINION,
            severity=severity,
            detail=(
                f"Annual project financial statements carry a "
                f"{project.audit_opinion.value}."
            ),
            project_id=project.project_id,
            references=[project.project_id],
        )]


