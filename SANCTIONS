class SinkholeOutcome(Enum):
    AUTHORIZED = "AUTHORIZED"
    AUTHORIZED_WITH_COALITION_CONCURRENCE = "AUTHORIZED_WITH_COALITION_CONCURRENCE"
    REFERRED_TO_LEGAL_PROCESS = "REFERRED_TO_LEGAL_PROCESS"
    DENIED_JURISDICTION = "DENIED_JURISDICTION"
    DENIED_HUMANITARIAN = "DENIED_HUMANITARIAN"
    HELD_INSUFFICIENT_EVIDENCE = "HELD_INSUFFICIENT_EVIDENCE"


ACTIONABLE_TIERS: Set[CaseTier] = {CaseTier.ACUTE, CaseTier.ELEVATED}


@dataclass
class SinkholeRequest:
    """A proposed sinkhole action against one piece of infrastructure."""
    indicator: str
    hosting_jurisdiction: str
    registrar_jurisdiction: str
    requesting_alliance: Alliance
    civilian_payment_share: float = 0.0
    humanitarian_review_cleared: bool = False

    def __post_init__(self) -> None:
        if not 0.0 <= self.civilian_payment_share <= 1.0:
            raise ValueError("civilian_payment_share must be within 0.0-1.0")
        self.hosting_jurisdiction = self.hosting_jurisdiction.upper()
        self.registrar_jurisdiction = self.registrar_jurisdiction.upper()


@dataclass
class SinkholeDecision:
    """Recorded disposition of a sinkhole request."""
    request: SinkholeRequest
    case_id: str
    outcome: SinkholeOutcome
    relation: Relation
    rationale: List[str] = field(default_factory=list)
    conditions: List[str] = field(default_factory=list)
    decided_at: str = field(default_factory=_utcnow)

    @property
    def approved(self) -> bool:
        return self.outcome in {
            SinkholeOutcome.AUTHORIZED,
            SinkholeOutcome.AUTHORIZED_WITH_COALITION_CONCURRENCE,
        }

    def to_dict(self) -> Dict[str, object]:
        return {
            "case_id": self.case_id,
            "indicator": self.request.indicator,
            "hosting_jurisdiction": self.request.hosting_jurisdiction,
            "registrar_jurisdiction": self.request.registrar_jurisdiction,
            "requesting_alliance": self.request.requesting_alliance.name,
            "relation": self.relation.value,
            "outcome": self.outcome.value,
            "approved": self.approved,
            "rationale": list(self.rationale),
            "conditions": list(self.conditions),
            "decided_at": self.decided_at,
        }


# Civilian payment exposure above this share blocks action pending review.
HUMANITARIAN_EXPOSURE_THRESHOLD = 0.15


class SinkholeAuthority:
    """Alliance-gated authorization for defensive sinkhole action.

    Precedence is deliberate: evidentiary sufficiency, then humanitarian
    exposure, then jurisdiction. A technically easy takedown in a member state
    is still refused when civilians are settling on the same rails.
    """

    def evaluate(self, case: EvasionCase, request: SinkholeRequest) -> SinkholeDecision:
        relation = AllianceRegistry.relation(
            request.requesting_alliance, request.hosting_jurisdiction
        )
        rationale: List[str] = []
        conditions: List[str] = []

        tier = case.tier()
        rationale.append(f"Case {case.case_id} scored {case.score()} ({tier.value}).")

        if tier not in ACTIONABLE_TIERS:
            rationale.append(
                "Score is below the ELEVATED action threshold; collection continues."
            )
            return SinkholeDecision(
                request, case.case_id, SinkholeOutcome.HELD_INSUFFICIENT_EVIDENCE,
                relation, rationale, conditions,
            )

        if (
            request.civilian_payment_share > HUMANITARIAN_EXPOSURE_THRESHOLD
            and not request.humanitarian_review_cleared
        ):
            rationale.append(
                f"Civilian payment exposure {request.civilian_payment_share:.0%} exceeds "
                f"the {HUMANITARIAN_EXPOSURE_THRESHOLD:.0%} threshold without a cleared "
                "humanitarian review."
            )
            conditions.append(
                "Route to humanitarian carve-out review; re-file with a narrowed "
                "indicator set that excludes remittance and medical-supply flows."
            )
            return SinkholeDecision(
                request, case.case_id, SinkholeOutcome.DENIED_HUMANITARIAN,
                relation, rationale, conditions,
            )

        rationale.append(
            f"Hosting jurisdiction {request.hosting_jurisdiction} stands as "
            f"{relation.value} to {request.requesting_alliance.name}."
        )

        if relation is Relation.MEMBER:
            conditions.extend([
                "Obtain the domestic legal order required by the hosting state.",
                "Log sinkhole collection scope and retention before cutover.",
            ])
            return SinkholeDecision(
                request, case.case_id, SinkholeOutcome.AUTHORIZED,
                relation, rationale, conditions,
            )

        if relation is Relation.PARTNER:
            conditions.extend([
                "Secure written concurrence from the hosting partner's authority.",
                "Share the evidentiary package before cutover, not after.",
            ])
            return SinkholeDecision(
                request, case.case_id,
                SinkholeOutcome.AUTHORIZED_WITH_COALITION_CONCURRENCE,
                relation, rationale, conditions,
            )

        if relation is Relation.NEUTRAL:
            conditions.append(
                "File mutual legal assistance request with the hosting state."
            )
            return SinkholeDecision(
                request, case.case_id, SinkholeOutcome.REFERRED_TO_LEGAL_PROCESS,
                relation, rationale, conditions,
            )

        # CONTESTED or ADVERSARIAL hosting: no unilateral technical action.
        registrar_relation = AllianceRegistry.relation(
            request.requesting_alliance, request.registrar_jurisdiction
        )
        rationale.append(
            "Unilateral action in a contested or adversarial jurisdiction is out of "
            "scope for this authority."
        )
        if registrar_relation in {Relation.MEMBER, Relation.PARTNER}:
            rationale.append(
                f"Registrar jurisdiction {request.registrar_jurisdiction} stands as "
                f"{registrar_relation.value}, so a registry-level path exists."
            )
            conditions.append(
                "Pursue registrar suspension or DNS-level abuse process instead of "
                "in-country sinkholing."
            )
            return SinkholeDecision(
                request, case.case_id, SinkholeOutcome.REFERRED_TO_LEGAL_PROCESS,
                relation, rationale, conditions,
            )

        conditions.append(
            "Escalate to the policy and designation track; recommend listing rather "
            "than technical action."
        )
        return SinkholeDecision(
            request, case.case_id, SinkholeOutcome.DENIED_JURISDICTION,
            relation, rationale, conditions,
        )


