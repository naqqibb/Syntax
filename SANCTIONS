class Relation(Enum):
    """Standing between a requesting alliance and a hosting jurisdiction."""
    MEMBER = "MEMBER"
    PARTNER = "PARTNER"
    NEUTRAL = "NEUTRAL"
    CONTESTED = "CONTESTED"
    ADVERSARIAL = "ADVERSARIAL"


RELATION_SEVERITY: Dict[Relation, int] = {
    Relation.MEMBER: 0,
    Relation.PARTNER: 1,
    Relation.NEUTRAL: 2,
    Relation.CONTESTED: 3,
    Relation.ADVERSARIAL: 4,
}


# Bloc-to-bloc standing. Absent pairs default to NEUTRAL.
ALLIANCE_RELATIONS: Dict[Alliance, Dict[Alliance, Relation]] = {
    Alliance.NATO: {
        Alliance.EU_CSDP: Relation.PARTNER,
        Alliance.AUKUS: Relation.PARTNER,
        Alliance.GCC: Relation.PARTNER,
        Alliance.SCO: Relation.CONTESTED,
        Alliance.CSTO: Relation.ADVERSARIAL,
