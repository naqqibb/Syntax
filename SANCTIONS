@dataclass
class MonetaryObservation:
    """Mixed-method observation of a wartime monetary field site.

    Quantitative fields are ratios in 0.0-1.0 unless noted; `practices` carries
    the qualitative register - what people are actually observed doing with
    money - which is what makes the classification legible to an analyst.
    """
    site: str
    country: str
    official_rate: float
    parallel_rate: float
    dollarization_ratio: float = 0.0
    barter_share: float = 0.0
    crypto_settlement_share: float = 0.0
    remittance_dependency: float = 0.0
    scrip_in_circulation: bool = False
    practices: List[str] = field(default_factory=list)
    observed_at: str = field(default_factory=_utcnow)

    def __post_init__(self) -> None:
        if self.official_rate <= 0 or self.parallel_rate <= 0:
            raise ValueError("exchange rates must be positive")
        for name in (
            "dollarization_ratio",
            "barter_share",
            "crypto_settlement_share",
            "remittance_dependency",
        ):
            value = getattr(self, name)
            if not 0.0 <= value <= 1.0:
                raise ValueError(f"{name} must be within 0.0-1.0")
        self.country = self.country.upper()

    @property
    def parallel_premium(self) -> float:
        """Parallel-market premium over the official rate, as a ratio."""
        return round(self.parallel_rate / self.official_rate - 1.0, 4)

    def classify(self) -> MonetaryRegime:
        """Assign a monetary regime, most disruptive condition first."""
        if self.barter_share >= 0.30:
            return MonetaryRegime.BARTER_REVERSION
        if self.scrip_in_circulation:
            return MonetaryRegime.SCRIP_AND_COUPON
        if self.crypto_settlement_share >= 0.25:
            return MonetaryRegime.CRYPTO_SUBSTITUTION
        if self.dollarization_ratio >= 0.70:
            return MonetaryRegime.HARD_DOLLARIZATION
        if self.parallel_premium >= 0.50:
            return MonetaryRegime.PARALLEL_MARKET_DOMINANT
        if self.dollarization_ratio >= 0.35:
            return MonetaryRegime.SOFT_DOLLARIZATION
        return MonetaryRegime.STABLE_FIAT

    def stress_index(self) -> float:
        """0-100 monetary stress composite for cross-site comparison."""
        premium_component = min(self.parallel_premium, 2.0) / 2.0
        raw = (
            0.30 * premium_component
            + 0.25 * self.dollarization_ratio
            + 0.20 * self.barter_share
            + 0.15 * self.crypto_settlement_share
            + 0.10 * self.remittance_dependency
        )
        if self.scrip_in_circulation:
            raw = min(1.0, raw + 0.10)
        return round(raw * 100.0, 1)

    def typology_priors(self) -> List[EvasionTypology]:
        """Typologies the observed regime structurally subsidizes."""
        return list(REGIME_TYPOLOGY_PRIORS[self.classify()])

    def field_note(self) -> str:
        """Analyst-facing narrative tying indicators back to practice."""
        regime = self.classify()
        premium_pct = self.parallel_premium * 100.0
        lines = [
            f"{self.site} ({self.country}) reads as {regime.value.lower()}: "
            f"the parallel rate sits {premium_pct:.1f}% above the official quote, "
            f"with {self.dollarization_ratio * 100:.0f}% of settlement in hard currency "
            f"and {self.barter_share * 100:.0f}% in kind."
        ]
        if self.scrip_in_circulation:
            lines.append(
                "Locally issued scrip and coupons circulate alongside notes, which "
                "means the unit of account has detached from the means of payment."
            )
        if self.crypto_settlement_share >= 0.10:
            lines.append(
                f"Roughly {self.crypto_settlement_share * 100:.0f}% of cross-border "
                "settlement moves through virtual assets, mostly stablecoins held "
                "by brokers rather than end users."
            )
        if self.remittance_dependency >= 0.30:
            lines.append(
                f"Household income is {self.remittance_dependency * 100:.0f}% "
                "remittance-dependent; any action on payment rails is a civilian "
                "welfare question before it is an enforcement question."
            )
        for practice in self.practices:
            lines.append(f"Observed: {practice.rstrip('.')}.")
        priors = self.typology_priors()
        if priors:
            lines.append(
                "Regime priors favour: "
                + ", ".join(prior.value for prior in priors)
                + "."
            )
        return " ".join(lines)

    def to_dict(self) -> Dict[str, object]:
        return {
            "site": self.site,
            "country": self.country,
            "observed_at": self.observed_at,
            "official_rate": self.official_rate,
            "parallel_rate": self.parallel_rate,
            "parallel_premium": self.parallel_premium,
            "dollarization_ratio": self.dollarization_ratio,
            "barter_share": self.barter_share,
            "crypto_settlement_share": self.crypto_settlement_share,
            "remittance_dependency": self.remittance_dependency,
            "scrip_in_circulation": self.scrip_in_circulation,
            "regime": self.classify().name,
            "regime_label": self.classify().value,
            "stress_index": self.stress_index(),
            "typology_priors": [prior.name for prior in self.typology_priors()],
            "practices": list(self.practices),
            "field_note": self.field_note(),
        }


