class SanctionsEvasionTracker:
    """Holds cases, field observations, and sinkhole dispositions."""

    def __init__(self) -> None:
        self.cases: Dict[str, EvasionCase] = {}
        self.observations: List[MonetaryObservation] = []
        self.decisions: List[SinkholeDecision] = []
        self.authority = SinkholeAuthority()

    def track(self, case: EvasionCase) -> EvasionCase:
        self.cases[case.case_id] = case
        return case

    def observe(self, observation: MonetaryObservation) -> MonetaryObservation:
        self.observations.append(observation)
        return observation

    def request_sinkhole(self, case_id: str, request: SinkholeRequest) -> SinkholeDecision:
        if case_id not in self.cases:
            raise KeyError(f"unknown case: {case_id}")
        decision = self.authority.evaluate(self.cases[case_id], request)
        self.decisions.append(decision)
        return decision

    def prioritized_cases(self) -> List[EvasionCase]:
        return sorted(self.cases.values(), key=lambda case: case.score(), reverse=True)

    def corroborated_by_ethnography(self, case: EvasionCase) -> List[EvasionTypology]:
        """Typologies in the case that field observations predicted.

        Only observations from jurisdictions the case actually touches count,
        so a regime prior from an unrelated field site cannot inflate a case.
        """
        priors: Set[EvasionTypology] = set()
        for observation in self.observations:
            if observation.country in case.jurisdictions:
                priors.update(observation.typology_priors())
        return sorted(priors & case.typology_profile, key=lambda t: t.name)

    def build_report(self) -> Dict[str, object]:
        cases = self.prioritized_cases()
        return {
            "status": "OPERATIONAL",
            "module": "SYNTAX SANCTIONS",
            "generated_at": _utcnow(),
            "tracked_cases": len(cases),
            "actionable_cases": sum(
                1 for case in cases if case.tier() in ACTIONABLE_TIERS
            ),
            "total_exposure_usd": round(sum(case.exposure_usd for case in cases), 2),
            "field_sites": len(self.observations),
            "sinkhole_decisions": len(self.decisions),
            "sinkhole_approved": sum(1 for d in self.decisions if d.approved),
            "cases": [case.to_dict() for case in cases],
            "observations": [obs.to_dict() for obs in self.observations],
            "decisions": [decision.to_dict() for decision in self.decisions],
        }

    def print_report(self, report: Optional[Dict[str, object]] = None) -> None:
        if report is None:
            report = self.build_report()

        tier_colors = {
            "ACUTE": Colors.RED,
            "ELEVATED": Colors.YELLOW,
            "EMERGENT": Colors.CYAN,
            "WATCH": Colors.GREEN,
            "NOISE": Colors.WHITE,
        }

        print("=" * 78)
        print(f"{Colors.BOLD}{Colors.CYAN}SYNTAX SANCTIONS EVASION TRACKER{Colors.RESET}")
        print(f"Generated {report['generated_at']}")
        print("=" * 78)

        print(f"\n{Colors.BOLD}{Colors.MAGENTA}> Evasion cases{Colors.RESET}")
        print("-" * 78)
        for case in report["cases"]:
            color = tier_colors.get(str(case["tier"]), Colors.WHITE)
            print(
                f"{color}[{case['tier']:>8}]{Colors.RESET} {case['case_id']} "
                f"score={case['score']:<5} {case['subject']}"
            )
            print(
                f"           regime={case['target_regime']} "
                f"typologies={len(case['typologies'])} "
                f"exposure=${case['exposure_usd']:,.0f}"
            )

        print(f"\n{Colors.BOLD}{Colors.MAGENTA}> Monetary field sites{Colors.RESET}")
        print("-" * 78)
        for observation in report["observations"]:
            print(
                f"{Colors.BLUE}[{observation['stress_index']:>5}]{Colors.RESET} "
                f"{observation['site']} ({observation['country']}) - "
                f"{observation['regime_label']}"
            )
            print(f"           {observation['field_note']}")

        print(f"\n{Colors.BOLD}{Colors.MAGENTA}> Sinkhole dispositions{Colors.RESET}")
        print("-" * 78)
        for decision in report["decisions"]:
            color = Colors.GREEN if decision["approved"] else Colors.RED
            print(
                f"{color}[{decision['outcome']}]{Colors.RESET} "
                f"{decision['indicator']} host={decision['hosting_jurisdiction']} "
                f"({decision['relation']}) requester={decision['requesting_alliance']}"
            )
            for line in decision["rationale"]:
                print(f"           - {line}")
            for condition in decision["conditions"]:
                print(f"           * {condition}")

        print("\n" + "=" * 78)
        print(
            f"Cases: {report['tracked_cases']} | "
            f"Actionable: {report['actionable_cases']} | "
            f"Sites: {report['field_sites']} | "
            f"Sinkholes approved: {report['sinkhole_approved']}/"
            f"{report['sinkhole_decisions']}"
        )
        print("=" * 78)


