        Alliance.EU_CSDP: Relation.PARTNER,
        Alliance.AUKUS: Relation.NEUTRAL,
        Alliance.CSTO: Relation.CONTESTED,
        Alliance.SCO: Relation.NEUTRAL,
    },
}


class AllianceRegistry:
    """Resolve country codes to blocs and score jurisdictional standing."""

    @staticmethod
    def alliances_of(country: str) -> List[Alliance]:
        code = country.upper()
        found = [
            alliance
            for alliance, members in ALLIANCE_MEMBERS.items()
            if code in members
        ]
        return found or [Alliance.NON_ALIGNED]

    @staticmethod
    def relation(requester: Alliance, country: str) -> Relation:
        """Standing of `country` as seen from `requester`.

        A country inside the requesting bloc is a MEMBER. Otherwise the most
        restrictive standing across every bloc it belongs to governs, so dual
        membership never launders a jurisdiction into an easier lane.
        """
        code = country.upper()
        if code in ALLIANCE_MEMBERS.get(requester, set()):
            return Relation.MEMBER

        host_blocs = AllianceRegistry.alliances_of(code)
        if host_blocs == [Alliance.NON_ALIGNED]:
            return Relation.NEUTRAL

        relations = [
            ALLIANCE_RELATIONS.get(requester, {}).get(bloc, Relation.NEUTRAL)
            for bloc in host_blocs
        ]
        return max(relations, key=lambda rel: RELATION_SEVERITY[rel])


