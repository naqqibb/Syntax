    HAWALA_SETTLEMENT = "Informal value transfer (hawala) settlement"
    PARALLEL_FX_ARBITRAGE = "Parallel-market FX arbitrage"


# Base severity weight per typology, 0-10. Reflects how directly the typology
# supports restricted acquisition rather than how common it is.
TYPOLOGY_WEIGHT: Dict[EvasionTypology, float] = {
    EvasionTypology.DUAL_USE_REEXPORT: 9.5,
    EvasionTypology.FRONT_PROCUREMENT_NETWORK: 9.0,
    EvasionTypology.DARK_FLEET_AIS_GAP: 8.5,
