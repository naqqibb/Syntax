}


class CaseTier(Enum):
    """Composite tiering of an evasion case."""
    ACUTE = "ACUTE"
    ELEVATED = "ELEVATED"
    EMERGENT = "EMERGENT"
    WATCH = "WATCH"
    NOISE = "NOISE"


TIER_THRESHOLDS: Sequence[Tuple[float, CaseTier]] = (
    (80.0, CaseTier.ACUTE),
    (60.0, CaseTier.ELEVATED),
    (40.0, CaseTier.EMERGENT),
    (20.0, CaseTier.WATCH),
)


@dataclass
class EvasionSignal:
    """A single observed indicator attributed to one typology."""
    typology: EvasionTypology
    description: str
    jurisdiction: str
    confidence: float = 0.5
    sources: List[str] = field(default_factory=list)
    value_usd: Optional[float] = None
    observed_at: str = field(default_factory=_utcnow)

    def __post_init__(self) -> None:
        if not 0.0 <= self.confidence <= 1.0:
            raise ValueError("confidence must be within 0.0-1.0")
        self.jurisdiction = self.jurisdiction.upper()

    @property
    def weighted_score(self) -> float:
        """Typology weight scaled by analyst confidence."""
        return TYPOLOGY_WEIGHT[self.typology] * self.confidence

    def to_dict(self) -> Dict[str, object]:
        return {
            "typology": self.typology.name,
            "typology_label": self.typology.value,
            "description": self.description,
            "jurisdiction": self.jurisdiction,
            "confidence": self.confidence,
            "sources": list(self.sources),
            "value_usd": self.value_usd,
            "observed_at": self.observed_at,
        }


@dataclass
class EvasionCase:
    """A tracked network of related evasion signals."""
    case_id: str
    subject: str
    target_regime: str
    signals: List[EvasionSignal] = field(default_factory=list)
    infrastructure: List[str] = field(default_factory=list)
    opened_at: str = field(default_factory=_utcnow)

    def add_signal(self, signal: EvasionSignal) -> "EvasionCase":
        self.signals.append(signal)
        return self

    @property
    def typology_profile(self) -> Set[EvasionTypology]:
        return {signal.typology for signal in self.signals}

    @property
    def corroborating_sources(self) -> Set[str]:
        return {source for signal in self.signals for source in signal.sources}

    @property
    def exposure_usd(self) -> float:
        return sum(signal.value_usd or 0.0 for signal in self.signals)

    @property
    def jurisdictions(self) -> Set[str]:
        return {signal.jurisdiction for signal in self.signals}

    def score(self) -> float:
        """Composite 0-100 score.

        Contributions decay geometrically so a single loud indicator cannot
        carry a case; breadth of typology and independent corroboration are
        what push a case into actionable tiers.
        """
        if not self.signals:
            return 0.0

        contributions = sorted(
            (signal.weighted_score for signal in self.signals), reverse=True
        )
        base = sum(value * (0.7 ** index) for index, value in enumerate(contributions))

        breadth = len(self.typology_profile)
        corroboration = len(self.corroborating_sources)
        multiplier = 1.0 + 0.08 * (breadth - 1) + 0.04 * max(0, corroboration - 1)
        multiplier = min(multiplier, 1.75)

        return round(min(100.0, base * multiplier * 3.0), 1)

    def tier(self) -> CaseTier:
        score = self.score()
        for threshold, tier in TIER_THRESHOLDS:
            if score >= threshold:
                return tier
        return CaseTier.NOISE

    def to_dict(self) -> Dict[str, object]:
        return {
            "case_id": self.case_id,
            "subject": self.subject,
            "target_regime": self.target_regime,
            "opened_at": self.opened_at,
            "score": self.score(),
            "tier": self.tier().value,
            "typologies": sorted(t.name for t in self.typology_profile),
            "jurisdictions": sorted(self.jurisdictions),
            "corroborating_sources": sorted(self.corroborating_sources),
            "exposure_usd": self.exposure_usd,
            "infrastructure": list(self.infrastructure),
            "signals": [signal.to_dict() for signal in self.signals],
        }


