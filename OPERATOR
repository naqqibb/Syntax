    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKCYAN = '\033[96m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    DIM = '\033[2m'


def print_banner():
    print(f"""{Colors.BOLD}{Colors.FAIL}
╔══════════════════════════════════════════════════════════════════════════════════════════╗
║                        SYNTAX v18.0 - ENTERPRISE SECURITY PLATFORM                       ║
║                     Real-Time Terminal Reporting & Incident Monitoring                   ║
║                                                                                          ║
╚══════════════════════════════════════════════════════════════════════════════════════════╝
{Colors.ENDC}""")


