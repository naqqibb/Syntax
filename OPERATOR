class DatabaseManager:
    """SQLite database management for persistent storage"""
    
    def __init__(self, db_file='syntax_v18.db'):
        """Initialize database connection"""
        self.db_file = db_file
        self.init_database()
    
    def init_database(self):
        """Create database schema if not exists"""
        conn = sqlite3.connect(self.db_file)
        c = conn.cursor()
        
        c.execute('''CREATE TABLE IF NOT EXISTS scan_reports (
            report_id TEXT PRIMARY KEY,
            report_type TEXT,
            timestamp DATETIME,
            findings INTEGER,
            severity_distribution TEXT
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS threats (
            threat_id TEXT PRIMARY KEY,
            threat_type TEXT,
            severity TEXT,
            source TEXT,
            timestamp DATETIME
        )''')
        
        c.execute('''CREATE TABLE IF NOT EXISTS compliance (
            check_id TEXT PRIMARY KEY,
            framework TEXT,
            score INTEGER,
            timestamp DATETIME
        )''')
        
        conn.commit()
        conn.close()


