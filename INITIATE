            TerminalUI.print_progress_bar(i + 1, 10)
            time.sleep(0.05)
        
        print()
        
        if CRYPTO_AVAILABLE:
            rsa.generate_private_key(
                public_exponent=65537,
                key_size=4096,
                backend=default_backend()
            )
        
        return {
            "algorithm": "ML-DSA-256",
            "key_size": 256,
            "status": "Active",
            "rotation_schedule": "Hourly",
            "last_rotation": datetime.now().isoformat()
        }

