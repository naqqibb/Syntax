class Severity(Enum):
    CRITICAL = "CRITICAL"
    HIGH = "HIGH"
    MEDIUM = "MEDIUM"
    LOW = "LOW"
    INFO = "INFO"


SEVERITY_ORDER: Dict[Severity, int] = {
    Severity.CRITICAL: 0,
    Severity.HIGH: 1,
    Severity.MEDIUM: 2,
    Severity.LOW: 3,
    Severity.INFO: 4,
}


class FindingCode(Enum):
    """Diagnostic conditions the cypher checks can raise."""
    UNKNOWN_CYPHER = "Coded value not present in the filing's code table"
    MISSING_REQUIRED_CYPHER = "Required coded field absent from the filing"
    STRUCTURING_PROXIMITY = "Amount sits just below a reporting threshold"
    THRESHOLD_SPLIT = "Sub-threshold filings aggregate past the threshold"
    CYPHER_AMOUNT_MISMATCH = "Coded instrument disagrees with the amount profile"
    JURISDICTION_CONFLICT = "Account jurisdiction diverges from subject jurisdiction"
    LATE_FILING = "Filed outside the statutory window"
    SUBTHRESHOLD_FILING = "Amount falls below the instrument's reporting threshold"


@dataclass
class Finding:
    """One diagnostic result against one or more filings."""
    code: FindingCode
    severity: Severity
    detail: str
    filing_ids: List[str]
    subject: str
    jurisdiction: str = "US"
    typology_hint: Optional[str] = None

    def to_dict(self) -> Dict[str, object]:
        return {
            "code": self.code.name,
            "description": self.code.value,
            "severity": self.severity.value,
            "detail": self.detail,
            "filing_ids": list(self.filing_ids),
            "subject": self.subject,
            "jurisdiction": self.jurisdiction,
            "typology_hint": self.typology_hint,
        }


# Findings that map onto a SANCTIONS evasion typology, with the confidence a
# single filing-level observation is worth on its own.
TYPOLOGY_BRIDGE: Dict[FindingCode, Tuple[str, float]] = {
    FindingCode.STRUCTURING_PROXIMITY: ("TRADE_MISINVOICING", 0.45),
    FindingCode.THRESHOLD_SPLIT: ("SHELL_LAYERING", 0.60),
    FindingCode.JURISDICTION_CONFLICT: ("CORRESPONDENT_BANK_NESTING", 0.50),
    FindingCode.CYPHER_AMOUNT_MISMATCH: ("TRADE_MISINVOICING", 0.40),
}

# SAR instrument codes that point at a specific typology when present.
