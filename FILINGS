def main() -> int:
    parser = argparse.ArgumentParser(
        description="SYNTAX IRS / BSA filing cypher diagnostician",
    )
    parser.add_argument(
        "--json", action="store_true", help="emit the diagnosis as JSON instead of text"
    )
    parser.add_argument(
        "--codes", action="store_true", help="print the cypher code tables and exit"
    )
    args = parser.parse_args()

    if args.codes:
        for filing_type, table in CYPHER_TABLES.items():
            print(f"\n{filing_type.name} - {filing_type.value}")
            for field_name, codes in table.items():
                print(f"  {field_name}:")
                for code, meaning in codes.items():
                    print(f"    {code:<6} {meaning}")
        return 0

    diagnosis = build_demo_diagnosis()
    report = diagnosis.build_report()

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        diagnosis.print_report(report)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        # Downstream closed the pipe (e.g. `| head`); exit quietly.
        sys.stderr.close()
        sys.exit(0)
