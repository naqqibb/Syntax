@dataclass
class Filing:
    """One submitted report with its coded fields and amounts."""
    filing_id: str
    filing_type: FilingType
    subject: str
    amount_usd: float
    transaction_date: str
    filed_date: str
    cyphers: Dict[str, str] = field(default_factory=dict)
    subject_jurisdiction: str = "US"
    account_jurisdiction: Optional[str] = None
    counterparty: Optional[str] = None

    def __post_init__(self) -> None:
        if self.amount_usd < 0:
            raise ValueError("amount_usd must not be negative")
        self.subject_jurisdiction = self.subject_jurisdiction.upper()
        if self.account_jurisdiction:
            self.account_jurisdiction = self.account_jurisdiction.upper()
        # Fail fast on malformed dates rather than deep inside a check.
        self.transaction_day
        self.filed_day

    @property
    def transaction_day(self) -> date:
        return date.fromisoformat(self.transaction_date)

    @property
    def filed_day(self) -> date:
        return date.fromisoformat(self.filed_date)

    @property
    def filing_lag_days(self) -> int:
        return (self.filed_day - self.transaction_day).days

    def decode(self) -> Dict[str, str]:
        """Resolve each coded field to its plain-language meaning."""
        table = CYPHER_TABLES.get(self.filing_type, {})
        decoded: Dict[str, str] = {}
        for name, code in self.cyphers.items():
            decoded[name] = table.get(name, {}).get(code, f"UNKNOWN CODE '{code}'")
        return decoded

    def to_dict(self) -> Dict[str, object]:
        return {
            "filing_id": self.filing_id,
            "filing_type": self.filing_type.name,
            "filing_label": self.filing_type.value,
            "subject": self.subject,
            "amount_usd": self.amount_usd,
            "transaction_date": self.transaction_date,
            "filed_date": self.filed_date,
            "filing_lag_days": self.filing_lag_days,
            "subject_jurisdiction": self.subject_jurisdiction,
            "account_jurisdiction": self.account_jurisdiction,
            "counterparty": self.counterparty,
            "cyphers": dict(self.cyphers),
            "decoded": self.decode(),
        }


