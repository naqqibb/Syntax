# DIAGNOSTICIAN
# ============================================================================

class FilingDiagnostician:
    """Runs cypher and consistency checks across a set of filings."""

    def diagnose(self, filings: Sequence[Filing]) -> List[Finding]:
        findings: List[Finding] = []
        for filing in filings:
            findings.extend(self._check_cyphers(filing))
            findings.extend(self._check_thresholds(filing))
            findings.extend(self._check_timeliness(filing))
            findings.extend(self._check_jurisdiction(filing))
        findings.extend(self._check_splits(filings))
        findings.sort(key=lambda f: (SEVERITY_ORDER[f.severity], f.code.name))
        return findings

    def _check_cyphers(self, filing: Filing) -> List[Finding]:
        findings: List[Finding] = []
        table = CYPHER_TABLES.get(filing.filing_type, {})

        for name in REQUIRED_FIELDS.get(filing.filing_type, ()):
            if name not in filing.cyphers:
                findings.append(Finding(
                    code=FindingCode.MISSING_REQUIRED_CYPHER,
                    severity=Severity.HIGH,
                    detail=f"{filing.filing_type.name} is missing '{name}'.",
                    filing_ids=[filing.filing_id],
                    subject=filing.subject,
                    jurisdiction=filing.subject_jurisdiction,
                ))

        for name, code in filing.cyphers.items():
            known = table.get(name, {})
            if not known:
                findings.append(Finding(
                    code=FindingCode.UNKNOWN_CYPHER,
                    severity=Severity.MEDIUM,
                    detail=(
                        f"Field '{name}' has no code table for "
                        f"{filing.filing_type.name}."
                    ),
                    filing_ids=[filing.filing_id],
                    subject=filing.subject,
                    jurisdiction=filing.subject_jurisdiction,
                ))
            elif code not in known:
                findings.append(Finding(
                    code=FindingCode.UNKNOWN_CYPHER,
                    severity=Severity.MEDIUM,
                    detail=(
                        f"Code '{code}' is not valid for '{name}' on "
                        f"{filing.filing_type.name}."
                    ),
                    filing_ids=[filing.filing_id],
                    subject=filing.subject,
                    jurisdiction=filing.subject_jurisdiction,
                ))

        findings.extend(self._check_instrument_consistency(filing))
        return findings

    def _check_instrument_consistency(self, filing: Filing) -> List[Finding]:
        """Cross-check a coded instrument against the amount it carries."""
        findings: List[Finding] = []

        if filing.filing_type is FilingType.FORM_8300:
            # Form 8300 exists to capture cash; a non-cash-equivalent code on a
            # large receipt means the instrument and the form disagree.
            payment = filing.cyphers.get("method_of_payment")
            if payment and payment not in {"A", "B", "C", "D", "E", "F"}:
                return findings
            nature = filing.cyphers.get("transaction_nature")
            if nature == "07" and payment in {"C", "D", "E"}:
                findings.append(Finding(
                    code=FindingCode.CYPHER_AMOUNT_MISMATCH,
                    severity=Severity.MEDIUM,
                    detail=(
                        "Exchange-of-cash nature coded against a negotiable "
                        "instrument rather than currency."
                    ),
                    filing_ids=[filing.filing_id],
                    subject=filing.subject,
                    jurisdiction=filing.subject_jurisdiction,
                    typology_hint="TRADE_MISINVOICING",
                ))

        if filing.filing_type is FilingType.SAR_111:
            instrument = filing.cyphers.get("instrument_involved")
            category = filing.cyphers.get("activity_category")
            if category == "STRUCT" and instrument not in {"CUR", "NEG", None}:
                findings.append(Finding(
                    code=FindingCode.CYPHER_AMOUNT_MISMATCH,
                    severity=Severity.MEDIUM,
                    detail=(
                        f"Structuring category coded against instrument "
                        f"'{instrument}', which is not currency or a "
                        "negotiable instrument."
                    ),
                    filing_ids=[filing.filing_id],
                    subject=filing.subject,
                    jurisdiction=filing.subject_jurisdiction,
                    typology_hint="TRADE_MISINVOICING",
                ))

        return findings

    def _check_thresholds(self, filing: Filing) -> List[Finding]:
        rule = REPORTING_THRESHOLDS.get(filing.filing_type)
        if rule is None or rule.threshold_usd is None:
            return []

        ratio = filing.amount_usd / rule.threshold_usd
        low, high = STRUCTURING_BAND

        if low <= ratio < high:
            return [Finding(
                code=FindingCode.STRUCTURING_PROXIMITY,
                severity=Severity.HIGH,
                detail=(
                    f"${filing.amount_usd:,.0f} is {ratio:.1%} of the "
                    f"${rule.threshold_usd:,.0f} threshold."
                ),
                filing_ids=[filing.filing_id],
                subject=filing.subject,
                jurisdiction=filing.subject_jurisdiction,
                typology_hint="TRADE_MISINVOICING",
            )]

        if ratio < low:
            return [Finding(
                code=FindingCode.SUBTHRESHOLD_FILING,
                severity=Severity.INFO,
                detail=(
                    f"${filing.amount_usd:,.0f} is below the "
                    f"${rule.threshold_usd:,.0f} threshold; filed voluntarily "
                    "or under another trigger."
                ),
                filing_ids=[filing.filing_id],
                subject=filing.subject,
                jurisdiction=filing.subject_jurisdiction,
            )]

        return []

    def _check_timeliness(self, filing: Filing) -> List[Finding]:
        rule = REPORTING_THRESHOLDS.get(filing.filing_type)
        if rule is None or rule.filing_window_days is None:
            return []

        lag = filing.filing_lag_days
        if lag > rule.filing_window_days:
            overdue = lag - rule.filing_window_days
            severity = Severity.HIGH if overdue > 30 else Severity.MEDIUM
            return [Finding(
                code=FindingCode.LATE_FILING,
                severity=severity,
                detail=(
                    f"Filed {lag} days after the transaction, "
                    f"{overdue} days past the {rule.filing_window_days}-day window."
                ),
                filing_ids=[filing.filing_id],
                subject=filing.subject,
                jurisdiction=filing.subject_jurisdiction,
            )]
        return []

    def _check_jurisdiction(self, filing: Filing) -> List[Finding]:
        account = filing.account_jurisdiction
        if not account or account == filing.subject_jurisdiction:
            return []
        return [Finding(
            code=FindingCode.JURISDICTION_CONFLICT,
            severity=Severity.MEDIUM,
            detail=(
                f"Account held in {account} against a subject of record in "
                f"{filing.subject_jurisdiction}."
            ),
            filing_ids=[filing.filing_id],
            subject=filing.subject,
            jurisdiction=account,
            typology_hint="CORRESPONDENT_BANK_NESTING",
        )]

    def _check_splits(self, filings: Sequence[Filing]) -> List[Finding]:
        """Sub-threshold filings by one subject that aggregate past it.

        Grouped per subject and filing type, since thresholds are per
        instrument; a run only counts when every filing in it is individually
        under the threshold but the run is not.
        """
        findings: List[Finding] = []
        groups: Dict[Tuple[str, FilingType], List[Filing]] = {}
        for filing in filings:
            groups.setdefault((filing.subject, filing.filing_type), []).append(filing)

        for (subject, filing_type), group in sorted(
            groups.items(), key=lambda item: (item[0][0], item[0][1].name)
        ):
            rule = REPORTING_THRESHOLDS.get(filing_type)
            if rule is None or rule.threshold_usd is None or len(group) < 2:
                continue

            ordered = sorted(group, key=lambda f: f.transaction_day)
            under = [f for f in ordered if f.amount_usd < rule.threshold_usd]
            if len(under) < 2:
                continue

            # Report the widest qualifying run rather than the first one found,
            # so a three-way split is not reported as a two-way split.
            best: List[Filing] = []
            for start in range(len(under)):
                for end in range(start + 1, len(under)):
                    span = (
                        under[end].transaction_day - under[start].transaction_day
                    ).days
                    if span > SPLIT_WINDOW_DAYS:
                        break
                    window = under[start:end + 1]
                    total = sum(f.amount_usd for f in window)
                    if total >= rule.threshold_usd and len(window) > len(best):
                        best = window

            if best:
                total = sum(f.amount_usd for f in best)
                span = (best[-1].transaction_day - best[0].transaction_day).days
                findings.append(Finding(
                    code=FindingCode.THRESHOLD_SPLIT,
                    severity=Severity.CRITICAL,
                    detail=(
                        f"{len(best)} sub-threshold {filing_type.name} "
                        f"filings totalling ${total:,.0f} across {span} days "
                        f"against a ${rule.threshold_usd:,.0f} threshold."
                    ),
                    filing_ids=[f.filing_id for f in best],
                    subject=subject,
                    jurisdiction=best[0].subject_jurisdiction,
                    typology_hint="SHELL_LAYERING",
                ))

        return findings


