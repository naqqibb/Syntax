class FilingDiagnosis:
    """Holds filings, runs the diagnostician, and reports."""

    def __init__(self) -> None:
        self.filings: List[Filing] = []
        self.diagnostician = FilingDiagnostician()

    def add(self, filing: Filing) -> Filing:
        self.filings.append(filing)
        return filing

    def findings(self) -> List[Finding]:
        return self.diagnostician.diagnose(self.filings)

    def severity_counts(self) -> Dict[str, int]:
        counts = {severity.value: 0 for severity in Severity}
        for finding in self.findings():
            counts[finding.severity.value] += 1
        return counts

    def evasion_signals(self) -> List[Dict[str, object]]:
        """Findings rendered as SANCTIONS-shaped evasion signals.

        Emitted as plain dictionaries so this module stays importable without
        SANCTIONS present; `to_sanctions_signals` builds the real objects.
        """
        signals: List[Dict[str, object]] = []
        for finding in self.findings():
            bridge = TYPOLOGY_BRIDGE.get(finding.code)
            typology = finding.typology_hint or (bridge[0] if bridge else None)
            if typology is None:
                continue
            confidence = bridge[1] if bridge else 0.40
            signals.append({
                "typology": typology,
                "description": finding.detail,
                "jurisdiction": finding.jurisdiction,
                "confidence": confidence,
                "sources": [f"irs-filing:{fid}" for fid in finding.filing_ids],
            })

        for filing in self.filings:
            if filing.filing_type is not FilingType.SAR_111:
                continue
            instrument = filing.cyphers.get("instrument_involved")
            mapped = SAR_INSTRUMENT_TYPOLOGY.get(instrument or "")
            if not mapped:
                continue
            typology, confidence = mapped
            signals.append({
                "typology": typology,
                "description": (
                    f"SAR coded {instrument} "
                    f"({filing.decode().get('instrument_involved')}) for "
                    f"${filing.amount_usd:,.0f}."
                ),
                "jurisdiction": filing.account_jurisdiction or filing.subject_jurisdiction,
                "confidence": confidence,
                "sources": [f"irs-filing:{filing.filing_id}"],
            })
        return signals

    def to_sanctions_signals(self) -> List[object]:
        """Build real SANCTIONS EvasionSignal objects from the diagnosis.

        Raises if the SANCTIONS module is unavailable or has no matching
        typology, rather than silently dropping evidence.
        """
        sanctions = load_sanctions_module()
        built = []
        for payload in self.evasion_signals():
            typology = getattr(sanctions.EvasionTypology, str(payload["typology"]))
            built.append(sanctions.EvasionSignal(
                typology=typology,
                description=str(payload["description"]),
                jurisdiction=str(payload["jurisdiction"]),
                confidence=float(payload["confidence"]),
                sources=list(payload["sources"]),
            ))
        return built

    def build_report(self) -> Dict[str, object]:
        findings = self.findings()
        return {
            "status": "OPERATIONAL",
            "module": "SYNTAX FILINGS",
            "generated_at": _utcnow(),
            "filings_reviewed": len(self.filings),
            "subjects": sorted({filing.subject for filing in self.filings}),
            "findings_total": len(findings),
            "severity_counts": self.severity_counts(),
            "filings": [filing.to_dict() for filing in self.filings],
            "findings": [finding.to_dict() for finding in findings],
            "evasion_signals": self.evasion_signals(),
        }

    def print_report(self, report: Optional[Dict[str, object]] = None) -> None:
        if report is None:
            report = self.build_report()

        severity_colors = {
            "CRITICAL": Colors.RED,
            "HIGH": Colors.YELLOW,
            "MEDIUM": Colors.CYAN,
            "LOW": Colors.GREEN,
            "INFO": Colors.WHITE,
        }

        print("=" * 78)
        print(f"{Colors.BOLD}{Colors.CYAN}SYNTAX IRS FILING CYPHER DIAGNOSIS{Colors.RESET}")
        print(f"Generated {report['generated_at']}")
        print("=" * 78)

        print(f"\n{Colors.BOLD}{Colors.MAGENTA}> Decoded filings{Colors.RESET}")
        print("-" * 78)
